# ---------------------------------------------------------------------------
# AM STORE environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Supabase (required for production)
#    Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key is ONLY used by `npm run seed` and `npm run create-admin`
# scripts. Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the site (metadata, sitemap, canonical URLs).
# For production set SITE_URL instead — it is read at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign the local admin session cookie when running without
# Supabase (local development only). Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=dev-only-change-me-please-0123456789abcdef

# Development admin account created automatically in the local SQLite database
# on first run. With Supabase configured, admins live in Supabase Auth instead
# (see `npm run create-admin`). Never ship the development password.
ADMIN_EMAIL=owner@amstore.in
ADMIN_PASSWORD=change-this-development-password

# ---------------------------------------------------------------------------
# 2. Optional: online payments (Razorpay). COD and pickup work without this.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
