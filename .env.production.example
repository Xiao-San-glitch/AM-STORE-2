# ---------------------------------------------------------------------------
# AM STORE — production settings for the VPS / Docker deployment
#
# Copy to `.env.production` on the server and fill in real values:
#   cp .env.production.example .env.production
#
# `.env.production` is git-ignored; never commit it.
# ---------------------------------------------------------------------------

# Public URL of the shop. Read at runtime, so one image works for any domain.
# Must be https for the admin panel to work (admin cookies are secure-only).
SITE_URL=https://store.example.com

# Signs the admin session cookie. Generate with: openssl rand -hex 32
# Changing it signs every admin out.
ADMIN_SESSION_SECRET=

# Admin account created automatically the first time the container starts on
# an empty database. After that these values are ignored — see the README
# section "Changing the admin login".
ADMIN_EMAIL=owner@amstore.in
ADMIN_PASSWORD=

# Leave unset (or "true") for normal HTTPS hosting. Set to "false" only while
# testing a production build over plain http://<server-ip>:3000, otherwise the
# browser refuses the admin cookie and sign-in silently fails.
# ADMIN_COOKIE_SECURE=false

# Where the SQLite database lives inside the container. The compose file
# overrides this to /app/.data/am-store.db, which is a persistent volume.
LOCAL_DB_PATH=/app/.data/am-store.db

# Optional: online payments. COD and pay-at-store work without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
